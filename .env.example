# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#
#   cp .env.example .env
#
# Get a key from https://console.anthropic.com/settings/keys
# The key is read only by server/index.js and is never sent to the browser.

ANTHROPIC_API_KEY=

# Port for the local API proxy. Vite proxies /api to this.
# Named API_PORT rather than PORT so it can't collide with the web server's.
API_PORT=8787
