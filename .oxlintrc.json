{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": [
        "server/**/*.js",
        "scripts/**/*.mjs",
        "*.config.js"
      ],
      "env": {
        "node": true,
        "browser": false
      }
    }
  ],
  "ignorePatterns": [
    "design_handoff_vocab_drawer_desktop/**",
    "dist/**"
  ]
}
