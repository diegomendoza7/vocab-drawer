{
  "name": "vocab-drawer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "node scripts/build-extension.mjs && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/build-extension.mjs && vite build && vitest run && node scripts/check-answers.mjs && node scripts/check-verbs.mjs && node scripts/audit-c1.mjs && node scripts/check-etymology.mjs && node scripts/check-morphology.mjs && node scripts/check-sentences.mjs && node scripts/check-images.mjs && node scripts/check-reading.mjs && node scripts/check-voices.mjs && node scripts/check-explanations.mjs && node scripts/check-lessons.mjs && node scripts/check-listening.mjs && oxlint",
    "test:browser": "node scripts/browser-check.mjs",
    "generate:listening": "node scripts/generate-listening.mjs",
    "download:models": "node --use-env-proxy scripts/download-models.mjs",
    "test:models": "node scripts/model-check.mjs",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@huggingface/transformers": "4.3.1",
    "@twemoji/svg": "^15.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "4.14.0",
    "concurrently": "^9.2.4",
    "oxlint": "^1.75.0",
    "playwright-core": "1.64.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
